#!/bin/sh
echo "$*" >> "$GH_LOG"
case "$1 $2" in
  "repo "*)
    printf '%s\n' $GH_REPOSITORIES
    ;;
  "pr list")
    printf '%s\n' $GH_OPEN_PULL_REQUESTS
    ;;
  "api --method")
    ;;
  "api "*)
    path=${2#repos/*/}
    name=${path%%/*}
    file=${path#*/contents/}
    directory="$GH_REMOTES/$name.git"
    if [ -z "$file" ]; then
      ls -p "$directory" | grep -v /
    else
      cat "$directory/$file"
    fi
    ;;
esac
